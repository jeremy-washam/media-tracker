{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "media-tracker",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "AUTH_MODE": "local",
    "CHAT_ENABLED": "true",
    "CHAT_CREDIT_PERIOD": "subscription-2026-10-30",
    "CHAT_CREDIT_LIMIT_USD": "13",
    "CHAT_CREDIT_EXPIRES_AT": "2026-11-12T00:00:00Z",
    "OPERATING_MONITOR_ENABLED": "false",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "OWNER_EMAIL": "",
    "SYNC_ENABLED": "true",
    "ARTICLE_CONTENT_ENABLED": "true",
    "SPOTIFY_CATALOG_ENABLED": "true",
    "MAINTENANCE_ENABLED": "false",
    "TMDB_CATALOG_JOB_ID": "",
    "TMDB_CATALOG_UNTIL": "",
  },
  "durable_objects": {
    "bindings": [{ "name": "CHAT_CONVERSATIONS", "class_name": "ChatConversationObject" }],
  },
  "migrations": [{ "tag": "chat-v1", "new_sqlite_classes": ["ChatConversationObject"] }],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "media-tracker",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/db/migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "RAW_BUCKET",
      "bucket_name": "media-tracker-raw",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "SYNC_QUEUE",
        "queue": "media-tracker-sync",
      },
    ],
    "consumers": [
      {
        "queue": "media-tracker-sync",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "dead_letter_queue": "media-tracker-sync-dead-letter",
      },
    ],
  },
  "triggers": {
    "crons": ["0 * * * *"],
  },
  "observability": {
    "enabled": true,
  },
  // Declared for generated types; explicit loopback development skips limits.
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 },
    },
    {
      "name": "WRITE_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
}
