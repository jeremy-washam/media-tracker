{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "media-tracker",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-18",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/__scheduled"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "media-tracker",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/db/migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "RAW_BUCKET",
      "bucket_name": "media-tracker-raw",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "SYNC_QUEUE",
        "queue": "media-tracker-sync",
      },
    ],
    "consumers": [
      {
        "queue": "media-tracker-sync",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "dead_letter_queue": "media-tracker-sync-dead-letter",
      },
    ],
  },
  "triggers": {
    "crons": ["0 * * * *"],
  },
  "observability": {
    "enabled": true,
  },
}
