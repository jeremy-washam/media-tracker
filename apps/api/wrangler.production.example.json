{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "media-tracker",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../web/dist-production",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "vars": {
    "AUTH_MODE": "access",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "OWNER_EMAIL": "",
    "SYNC_ENABLED": "false",
    "SYNC_SOURCES": "",
    "SYNC_BUDGET_UNTIL": "",
    "SYNC_RETRY_SOURCE": "",
    "ARTICLE_CONTENT_ENABLED": "false",
    "SPOTIFY_CATALOG_ENABLED": "false",
    "MAINTENANCE_ENABLED": "false",
    "CATALOG_AUTO_REFRESH": "false",
    "TMDB_CATALOG_JOB_ID": "",
    "TMDB_CATALOG_UNTIL": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "media-tracker",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "r2_buckets": [{ "binding": "RAW_BUCKET", "bucket_name": "media-tracker-raw" }],
  "queues": {
    "producers": [{ "binding": "SYNC_QUEUE", "queue": "media-tracker-sync" }],
    "consumers": []
  },
  "triggers": { "crons": [] },
  "limits": { "cpu_ms": 30000 },
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "WRITE_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
