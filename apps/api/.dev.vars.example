# Copy this file to .dev.vars and replace the placeholders locally.
# Never commit the real token or local configuration.
READWISE_TOKEN=replace-with-your-readwise-token
HARDCOVER_TOKEN=replace-with-your-hardcover-token
LETTERBOXD_USERNAME=replace-with-your-letterboxd-username
SPOTIFY_CLIENT_ID=replace-with-your-spotify-client-id
SPOTIFY_REFRESH_TOKEN=replace-with-your-spotify-refresh-token
# SPOTIFY_CLIENT_SECRET is only needed for a confidential-client Spotify app.
